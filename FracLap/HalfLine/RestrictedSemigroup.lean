/-!
# FracLap.HalfLine.RestrictedSemigroup

Concrete construction of the restricted (exterior-Dirichlet) fractional Laplacian contractive
resolvent `R_μ = (μ + (-Δ)_{(0, ∞)}^{α / 2})⁻¹` and its strongly continuous contraction semigroup
`S₀(t)` on `L²((0, ∞); ℝ)` (`L2IoiR`) via Lax--Milgram and Hille--Yosida, together with
Beurling--Deny sub-Markovianity:

- `restrictedL2Map`: continuous embedding `H^(α / 2)_0(0, ∞) →L[ℝ] L²((0, ∞); ℝ)` preserving the
  `L²` inner product of elements vanishing a.e. on `(-∞, 0]`.
- `denseRange_restrictedL2Map`: density of `H^(α / 2)_0(0, ∞)` in `L²((0, ∞); ℝ)`.
- `restrictedShiftedForm`, `restrictedShiftedForm_isCoercive`: shifted Dirichlet bilinear form
  `B_μ(u, v) = B^α_0(u, v) + μ ⟨u, v⟩_{L²}` for `μ > 0`, bounded and coercive on
  `RestrictedGagliardoSpace α`.
- `restrictedResolventSol`, `restrictedResolventOp`: Lax--Milgram variational solution and
  induced resolvent operator on `L²((0, ∞); ℝ)`.
- `restrictedFracLapResolvent`, `restrictedFracLapSemigroup`,
  `restrictedFracLapSemigroup_resolvent_eq`: concrete `ContractiveResolvent L2IoiR` and
  `StronglyContinuousContractionSemigroup L2IoiR` generated by Yosida approximations.
- `restrictedResolventOp_ae_nonneg`, `restrictedResolventOp_ae_le`,
  `restrictedFracLapSemigroup_ae_nonneg`, `restrictedFracLapSemigroup_ae_le`: positivity and
  sub-Markov `L^∞`-contractivity inherited from the Beurling--Deny Markov form inequalities.
- `exists_restrictedFracLapSemigroup_nontrivial`: explicit non-vacuity witness showing that
  `restrictedFracLapResolvent α hα` acts nontrivially on a nonnegative `L²((0, ∞); ℝ)` datum.
-/

namespace FracLap

open Filter MeasureTheory NormedSpace Real Set Topology
open scoped ENNReal NNReal InnerProductSpace SchwartzMap

@[expose] public section

/-! ### 1. Embedding of `RestrictedGagliardoSpace α` into `L²((0, ∞); ℝ)` and density -/

/-- Canonical continuous linear embedding `H^(α / 2)_0(0, ∞) →L[ℝ] L²((0, ∞); ℝ)` given by
taking the `L²(ℝ; ℝ)` component and restricting to `(0, ∞)`. -/
noncomputable def restrictedL2Map (α : ℝ) : RestrictedGagliardoSpace α →L[ℝ] L2IoiR :=
  restIoiR.comp ((gagliardoL2Part α).comp (restrictedGagliardoSubmodule α).subtypeL)

/-- Because elements of `RestrictedGagliardoSpace α` vanish a.e. on `(-∞, 0]`, `restrictedL2Map`
preserves the `L²` inner product of their whole-line components. -/
theorem inner_restrictedL2Map_eq (α : ℝ) (u v : RestrictedGagliardoSpace α) :
    ⟪restrictedL2Map α u, restrictedL2Map α v⟫_ℝ =
      ⟪gagliardoL2Part α u.1, gagliardoL2Part α v.1⟫_ℝ := by
  change ⟪restIoiR (gagliardoL2Part α u.1), restIoiR (gagliardoL2Part α v.1)⟫_ℝ = _
  rw [← inner_halfLineL2ExtendByZero_eq_restIoiR,
    halfLineL2ExtendByZero_restIoiR_of_ae_zero u.2]

/-- Norm-squared decomposition on `RestrictedGagliardoSpace α` in terms of `restrictedL2Map` and
`restrictedGagliardoForm`: `‖u‖² = ‖ι u‖²_{L²(0, ∞)} + B^α_0(u, u)`. -/
theorem norm_sq_restrictedGagliardoSpace (α : ℝ) (u : RestrictedGagliardoSpace α) :
    ‖u‖ ^ 2 = ‖restrictedL2Map α u‖ ^ 2 + (restrictedGagliardoForm α).form u u := by
  have hnorm : ‖u‖ ^ 2 = ‖u.1‖ ^ 2 := rfl
  rw [hnorm, norm_sq_gagliardoSpace α u.1, ← real_inner_self_eq_norm_sq (gagliardoL2Part α u.1),
    ← inner_restrictedL2Map_eq, real_inner_self_eq_norm_sq]
  change _ = ‖restrictedL2Map α u‖ ^ 2 + ⟪gagliardoDiffPart α u.1, gagliardoDiffPart α u.1⟫_ℝ
  rw [real_inner_self_eq_norm_sq]

/-- Every `u : RestrictedGagliardoSpace α` satisfies `‖restrictedL2Map α u‖ ≤ ‖u‖`. -/
theorem norm_restrictedL2Map_le (α : ℝ) (u : RestrictedGagliardoSpace α) :
    ‖restrictedL2Map α u‖ ≤ ‖u‖ := by
  have hsq : ‖restrictedL2Map α u‖ ^ 2 ≤ ‖u‖ ^ 2 := by
    rw [norm_sq_restrictedGagliardoSpace α u]
    exact le_add_of_nonneg_right ((restrictedGagliardoForm α).accretive u)
  exact le_of_pow_le_pow_left₀ two_ne_zero (norm_nonneg u) hsq

/-- Smooth compactly supported functions in `(0, ∞)` embed into `RestrictedGagliardoSpace α`. -/
theorem exists_restrictedGagliardoSpace_of_contDiff_tsupport {α : ℝ} (hα : FractionalExponent α)
    {φ : ℝ → ℝ} (hdiff : ContDiff ℝ (⊤ : ℕ∞) φ) (hsupp : HasCompactSupport φ)
    (htsupp : tsupport φ ⊆ Ioi (0 : ℝ)) :
    ∃ v : RestrictedGagliardoSpace α,
      (gagliardoL2Part α v.1 : ℝ → ℝ) =ᵐ[volume] φ := by
  let φs : 𝓢(ℝ, ℝ) := hsupp.toSchwartzMap hdiff
  let φc : 𝓢(ℝ, ℂ) := SchwartzMap.postcompCLM Complex.ofRealCLM φs
  have hφc_Lp : (φc.toLp 2 volume : L2C) = ofRealL2 (φs.toLp 2 volume : L2R) := by
    rw [Lp.ext_iff]
    filter_upwards [φc.coeFn_toLp 2 volume, coeFn_ofRealL2 (φs.toLp 2 volume : L2R),
      φs.coeFn_toLp 2 volume] with x h1 h2 h3
    have h1' : ((φc.toLp 2 volume : L2C) : ℝ → ℂ) x = φc x := h1
    have h3' : ((φs.toLp 2 volume : L2R) : ℝ → ℝ) x = φs x := h3
    rw [h1', h2, h3']
    rfl
  have hE : gagliardoEnergyR α (φs.toLp 2 volume : L2R) < ∞ := by
    rw [← gagliardoEnergyC_ofRealL2 α, ← hφc_Lp]
    exact gagliardoEnergyC_schwartz_lt_top hα φc
  let g : GagliardoSpace α := gagliardoMk (φs.toLp 2 volume : L2R) hE
  have hg_zero : g ∈ restrictedGagliardoSubmodule α := by
    change ∀ᵐ x : ℝ ∂volume, x ≤ 0 → (gagliardoL2Part α g : ℝ → ℝ) x = 0
    filter_upwards [φs.coeFn_toLp 2 volume] with x hx hx0
    have hx' : (gagliardoL2Part α g : ℝ → ℝ) x = φ x := hx
    rw [hx']
    refine Function.notMem_support.mp fun hsup => ?_
    exact not_lt.mpr hx0 (htsupp (subset_closure hsup))
  exact ⟨⟨g, hg_zero⟩, φs.coeFn_toLp 2 volume⟩

/-- **Density of `H^(α / 2)_0(0, ∞)` in `L²((0, ∞); ℝ)`**:
for `α ∈ (0, 2)`, the canonical embedding `restrictedL2Map α` has dense range in `L2IoiR`. -/
theorem denseRange_restrictedL2Map {α : ℝ} (hα : FractionalExponent α) :
    DenseRange (restrictedL2Map α) := by
  rw [DenseRange]
  have hcls : ((restrictedL2Map α).range : Submodule ℝ L2IoiR).topologicalClosure = ⊤ := by
    rw [Submodule.topologicalClosure_eq_top_iff, Submodule.eq_bot_iff]
    intro f hf
    have hloc : LocallyIntegrableOn (f : ℝ → ℝ) (Ioi (0 : ℝ)) volume := by
      intro x hx
      have hxpos : 0 < x := hx
      have hK_sub : Icc (x / 2) (x + 1) ⊆ Ioi (0 : ℝ) := fun y hy =>
        lt_of_lt_of_le (half_pos hxpos) hy.1
      have hmem : MemLp (f : ℝ → ℝ) 2 (volume.restrict (Icc (x / 2) (x + 1))) :=
        (Lp.memLp f).mono_measure (Measure.restrict_mono hK_sub le_rfl)
      have hint_K : IntegrableOn (f : ℝ → ℝ) (Icc (x / 2) (x + 1)) volume :=
        hmem.integrable one_le_two
      have hmem_nhds : Ioo (x / 2) (x + 1) ∈ nhdsWithin x (Ioi (0 : ℝ)) :=
        mem_nhdsWithin_of_mem_nhds (Ioo_mem_nhds (by linarith) (by linarith))
      exact ⟨Ioo (x / 2) (x + 1), hmem_nhds, hint_K.mono_set Ioo_subset_Icc_self⟩
    have hae : ∀ᵐ x : ℝ ∂volume, x ∈ Ioi (0 : ℝ) → (f : ℝ → ℝ) x = 0 := by
      refine isOpen_Ioi.ae_eq_zero_of_integral_contDiff_smul_eq_zero hloc ?_
      intro φ hdiff hsupp htsupp
      obtain ⟨v, hv⟩ := exists_restrictedGagliardoSpace_of_contDiff_tsupport hα hdiff hsupp htsupp
      have horth : ⟪restrictedL2Map α v, f⟫_ℝ = 0 := hf (restrictedL2Map α v) ⟨v, rfl⟩
      have hres : (restrictedL2Map α v : ℝ → ℝ) =ᵐ[volume.restrict (Ioi (0 : ℝ))] φ := by
        filter_upwards [coeFn_restIoiR (gagliardoL2Part α v.1),
          ae_restrict_of_ae hv] with x hx1 hx2
        exact hx1.trans hx2
      have hint_eq : ∫ x : ℝ, φ x • (f : ℝ → ℝ) x = ⟪restrictedL2Map α v, f⟫_ℝ := by
        rw [L2.inner_def, ← setIntegral_eq_integral_of_forall_compl_eq_zero]
        · refine setIntegral_congr_ae measurableSet_Ioi ?_
          filter_upwards [(ae_restrict_iff' measurableSet_Ioi).mp hres] with x hx hxI
          rw [hx hxI]
          change φ x * (f : ℝ → ℝ) x = (f : ℝ → ℝ) x * φ x
          ring
        · intro x hx
          have h0 : φ x = 0 :=
            Function.notMem_support.mp fun hsup => hx (htsupp (subset_closure hsup))
          simp [h0]
      rw [hint_eq, horth]
    rw [Lp.ext_iff]
    filter_upwards [ae_restrict_mem measurableSet_Ioi, ae_restrict_of_ae hae,
      Lp.coeFn_zero ℝ 2 (volume.restrict (Ioi (0 : ℝ)))] with x hxI hfx hz
    rw [hfx hxI, hz]
    rfl
  change Dense (SetLike.coe ((restrictedL2Map α).range : Submodule ℝ L2IoiR))
  rw [dense_iff_closure_eq]
  exact congrArg SetLike.coe hcls

/-! ### 2. Shifted coercive bilinear form and Lax--Milgram resolvent -/

/-- Shifted Dirichlet bilinear form `B_μ(u, v) = B^α_0(u, v) + μ ⟨ι u, ι v⟩_{L²(0, ∞)}`
on `RestrictedGagliardoSpace α`. -/
noncomputable def restrictedShiftedForm (α μ : ℝ) :
    RestrictedGagliardoSpace α →L[ℝ] RestrictedGagliardoSpace α →L[ℝ] ℝ :=
  LinearMap.mkContinuous₂
    { toFun := fun u =>
        { toFun := fun v =>
            ⟪gagliardoDiffPart α u.1, gagliardoDiffPart α v.1⟫_ℝ +
              μ * ⟪restrictedL2Map α u, restrictedL2Map α v⟫_ℝ
          map_add' := fun v w => by
            simp only [Submodule.coe_add, map_add, inner_add_right]
            ring
          map_smul' := fun c v => by
            simp only [Submodule.coe_smul, map_smul, inner_smul_right, RingHom.id_apply,
              smul_eq_mul]
            ring }
      map_add' := fun u w => by
        ext v
        simp only [LinearMap.coe_mk, AddHom.coe_mk, Submodule.coe_add, map_add, inner_add_left,
          LinearMap.add_apply]
        ring
      map_smul' := fun c u => by
        ext v
        simp only [LinearMap.coe_mk, AddHom.coe_mk, Submodule.coe_smul, map_smul, inner_smul_left,
          RingHom.id_apply, LinearMap.smul_apply, smul_eq_mul, starRingEnd_apply, star_trivial]
        ring }
    (1 + |μ|)
    (fun u v => by
      have hdiff_u : ‖gagliardoDiffPart α u.1‖ ≤ ‖u‖ := by
        have hsq : ‖gagliardoDiffPart α u.1‖ ^ 2 ≤ ‖u‖ ^ 2 := by
          change ‖gagliardoDiffPart α u.1‖ ^ 2 ≤ ‖u.1‖ ^ 2
          rw [norm_sq_gagliardoSpace α u.1]
          exact le_add_of_nonneg_left (sq_nonneg _)
        exact le_of_pow_le_pow_left₀ two_ne_zero (norm_nonneg u) hsq
      have hdiff_v : ‖gagliardoDiffPart α v.1‖ ≤ ‖v‖ := by
        have hsq : ‖gagliardoDiffPart α v.1‖ ^ 2 ≤ ‖v‖ ^ 2 := by
          change ‖gagliardoDiffPart α v.1‖ ^ 2 ≤ ‖v.1‖ ^ 2
          rw [norm_sq_gagliardoSpace α v.1]
          exact le_add_of_nonneg_left (sq_nonneg _)
        exact le_of_pow_le_pow_left₀ two_ne_zero (norm_nonneg v) hsq
      have h1 :
          |⟪gagliardoDiffPart α u.1, gagliardoDiffPart α v.1⟫_ℝ| ≤ ‖u‖ * ‖v‖ :=
        (abs_real_inner_le_norm _ _).trans
          (mul_le_mul hdiff_u hdiff_v (norm_nonneg _) (norm_nonneg _))
      have h2 : |μ * ⟪restrictedL2Map α u, restrictedL2Map α v⟫_ℝ| ≤ |μ| * (‖u‖ * ‖v‖) := by
        rw [abs_mul]
        exact mul_le_mul_of_nonneg_left
          ((abs_real_inner_le_norm _ _).trans
            (mul_le_mul (norm_restrictedL2Map_le α u) (norm_restrictedL2Map_le α v)
              (norm_nonneg _) (norm_nonneg _)))
          (abs_nonneg _)
      calc
        ‖⟪gagliardoDiffPart α u.1, gagliardoDiffPart α v.1⟫_ℝ +
            μ * ⟪restrictedL2Map α u, restrictedL2Map α v⟫_ℝ‖
            = |⟪gagliardoDiffPart α u.1, gagliardoDiffPart α v.1⟫_ℝ +
                μ * ⟪restrictedL2Map α u, restrictedL2Map α v⟫_ℝ| := Real.norm_eq_abs _
        _ ≤ |⟪gagliardoDiffPart α u.1, gagliardoDiffPart α v.1⟫_ℝ| +
              |μ * ⟪restrictedL2Map α u, restrictedL2Map α v⟫_ℝ| := abs_add_le _ _
        _ ≤ ‖u‖ * ‖v‖ + |μ| * (‖u‖ * ‖v‖) := add_le_add h1 h2
        _ = (1 + |μ|) * ‖u‖ * ‖v‖ := by ring)

/-- Evaluation formula for `restrictedShiftedForm`. -/
theorem restrictedShiftedForm_apply (α μ : ℝ) (u v : RestrictedGagliardoSpace α) :
    restrictedShiftedForm α μ u v =
      (restrictedGagliardoForm α).form u v +
        μ * ⟪restrictedL2Map α u, restrictedL2Map α v⟫_ℝ :=
  rfl

/-- Symmetry of `restrictedShiftedForm`. -/
theorem restrictedShiftedForm_symm (α μ : ℝ) (u v : RestrictedGagliardoSpace α) :
    restrictedShiftedForm α μ u v = restrictedShiftedForm α μ v u := by
  simp only [restrictedShiftedForm_apply, (restrictedGagliardoForm α).symm u v,
    real_inner_comm (restrictedL2Map α u) (restrictedL2Map α v)]

/-- Coercivity of `restrictedShiftedForm α (μ : ℝ)` for every `μ : PositiveShift` (`μ > 0`),
with coercivity constant `min 1 (μ : ℝ) > 0`. -/
theorem restrictedShiftedForm_isCoercive (α : ℝ) (μ : PositiveShift) :
    IsCoercive (restrictedShiftedForm α μ) := by
  refine ⟨min 1 (μ : ℝ), lt_min zero_lt_one μ.2, fun u => ?_⟩
  have h1 : min 1 (μ : ℝ) * (restrictedGagliardoForm α).form u u ≤
      (restrictedGagliardoForm α).form u u :=
    mul_le_of_le_one_left ((restrictedGagliardoForm α).accretive u) (min_le_left _ _)
  have h2 : min 1 (μ : ℝ) * ‖restrictedL2Map α u‖ ^ 2 ≤ (μ : ℝ) * ‖restrictedL2Map α u‖ ^ 2 :=
    mul_le_mul_of_nonneg_right (min_le_right _ _) (sq_nonneg _)
  calc
    min 1 (μ : ℝ) * ‖u‖ * ‖u‖ = min 1 (μ : ℝ) * ‖u‖ ^ 2 := by ring
    _ = min 1 (μ : ℝ) * ‖restrictedL2Map α u‖ ^ 2 +
          min 1 (μ : ℝ) * (restrictedGagliardoForm α).form u u := by
        rw [norm_sq_restrictedGagliardoSpace]; ring
    _ ≤ (μ : ℝ) * ‖restrictedL2Map α u‖ ^ 2 + (restrictedGagliardoForm α).form u u :=
        add_le_add h2 h1
    _ = restrictedShiftedForm α μ u u := by
        rw [restrictedShiftedForm_apply, real_inner_self_eq_norm_sq]
        ring

/-- Lax--Milgram variational solution operator `f ↦ u_μ ∈ H^(α / 2)_0(0, ∞)` satisfying
`B_μ(u_μ, v) = ⟨f, ι v⟩_{L²(0, ∞)}` for all `v ∈ H^(α / 2)_0(0, ∞)`. -/
noncomputable def restrictedResolventSol (α : ℝ) (μ : PositiveShift) :
    L2IoiR →L[ℝ] RestrictedGagliardoSpace α :=
  (laxMilgramEquivOfCoercive (restrictedShiftedForm_isCoercive α μ)).symm.toContinuousLinearMap.comp
    (restrictedL2Map α).adjoint

/-- Variational identity characterizing `restrictedResolventSol α μ f`. -/
theorem restrictedShiftedForm_resolventSol (α : ℝ) (μ : PositiveShift) (f : L2IoiR)
    (v : RestrictedGagliardoSpace α) :
    restrictedShiftedForm α μ (restrictedResolventSol α μ f) v = ⟪f, restrictedL2Map α v⟫_ℝ := by
  let E := laxMilgramEquivOfCoercive (restrictedShiftedForm_isCoercive α μ)
  calc
    restrictedShiftedForm α μ (restrictedResolventSol α μ f) v
        = ⟪E (E.symm ((restrictedL2Map α).adjoint f)), v⟫_ℝ :=
          (IsCoercive.continuousLinearEquivOfBilin_apply _ _ _).symm
    _ = ⟪(restrictedL2Map α).adjoint f, v⟫_ℝ := by rw [E.apply_symm_apply]
    _ = ⟪f, restrictedL2Map α v⟫_ℝ := ContinuousLinearMap.adjoint_inner_left _ _ _

/-- **Concrete Restricted Fractional Laplacian Resolvent Operator** on `L²((0, ∞); ℝ)`:
`R_μ f = ι (restrictedResolventSol α μ f)`. -/
noncomputable def restrictedResolventOp (α : ℝ) (μ : PositiveShift) : L2IoiR →L[ℝ] L2IoiR :=
  (restrictedL2Map α).comp (restrictedResolventSol α μ)

/-- Variational identity written directly in terms of `restrictedGagliardoForm` and
`restrictedResolventOp`. -/
theorem restrictedGagliardoForm_resolventSol (α : ℝ) (μ : PositiveShift) (f : L2IoiR)
    (v : RestrictedGagliardoSpace α) :
    (restrictedGagliardoForm α).form (restrictedResolventSol α μ f) v +
        (μ : ℝ) * ⟪restrictedResolventOp α μ f, restrictedL2Map α v⟫_ℝ =
      ⟪f, restrictedL2Map α v⟫_ℝ :=
  restrictedShiftedForm_resolventSol α μ f v

/-- Symmetry (self-adjointness) of `restrictedResolventOp α μ` on `L²((0, ∞); ℝ)`. -/
theorem inner_restrictedResolventOp_symm (α : ℝ) (μ : PositiveShift) (f g : L2IoiR) :
    ⟪restrictedResolventOp α μ f, g⟫_ℝ = ⟪f, restrictedResolventOp α μ g⟫_ℝ := by
  calc
    ⟪restrictedResolventOp α μ f, g⟫_ℝ = ⟪g, restrictedResolventOp α μ f⟫_ℝ := real_inner_comm _ _
    _ = restrictedShiftedForm α μ (restrictedResolventSol α μ g) (restrictedResolventSol α μ f) :=
        (restrictedShiftedForm_resolventSol α μ g (restrictedResolventSol α μ f)).symm
    _ = restrictedShiftedForm α μ (restrictedResolventSol α μ f) (restrictedResolventSol α μ g) :=
        restrictedShiftedForm_symm α μ _ _
    _ = ⟪f, restrictedResolventOp α μ g⟫_ℝ :=
        restrictedShiftedForm_resolventSol α μ f (restrictedResolventSol α μ g)

/-- Resolvent identity `R_μ - R_ν = (ν - μ) • (R_μ ∘ R_ν)`. -/
theorem restrictedResolventOp_identity (α : ℝ) (μ ν : PositiveShift) :
    restrictedResolventOp α μ - restrictedResolventOp α ν =
      ((ν : ℝ) - (μ : ℝ)) • ((restrictedResolventOp α μ).comp (restrictedResolventOp α ν)) := by
  ext1 f
  let uμ := restrictedResolventSol α μ f
  let uν := restrictedResolventSol α ν f
  let w := restrictedResolventSol α μ (restrictedResolventOp α ν f)
  let d : RestrictedGagliardoSpace α := uμ - uν - ((ν : ℝ) - (μ : ℝ)) • w
  have hd_test : ∀ v : RestrictedGagliardoSpace α, restrictedShiftedForm α μ d v = 0 := by
    intro v
    have hlin :
        restrictedShiftedForm α μ d v =
          restrictedShiftedForm α μ uμ v - restrictedShiftedForm α μ uν v -
            ((ν : ℝ) - (μ : ℝ)) * restrictedShiftedForm α μ w v := by
      simp only [d, map_sub, map_smul, sub_apply, FunLike.coe_smul,
        Pi.smul_apply, smul_eq_mul]
    rw [hlin]
    have hμ := restrictedShiftedForm_resolventSol α μ f v
    have hν := restrictedShiftedForm_resolventSol α ν f v
    have hw := restrictedShiftedForm_resolventSol α μ (restrictedResolventOp α ν f) v
    have hshift :
        restrictedShiftedForm α μ uν v =
          restrictedShiftedForm α ν uν v +
            ((μ : ℝ) - (ν : ℝ)) * ⟪restrictedResolventOp α ν f, restrictedL2Map α v⟫_ℝ := by
      change (restrictedGagliardoForm α).form uν v +
          (μ : ℝ) * ⟪restrictedL2Map α uν, restrictedL2Map α v⟫_ℝ =
        ((restrictedGagliardoForm α).form uν v +
          (ν : ℝ) * ⟪restrictedL2Map α uν, restrictedL2Map α v⟫_ℝ) +
        ((μ : ℝ) - (ν : ℝ)) * ⟪restrictedL2Map α uν, restrictedL2Map α v⟫_ℝ
      ring
    rw [hμ, hshift, hν, hw]
    change ⟪f, restrictedL2Map α v⟫_ℝ -
        (⟪f, restrictedL2Map α v⟫_ℝ +
          ((μ : ℝ) - (ν : ℝ)) * ⟪restrictedResolventOp α ν f, restrictedL2Map α v⟫_ℝ) -
        ((ν : ℝ) - (μ : ℝ)) * ⟪restrictedResolventOp α ν f, restrictedL2Map α v⟫_ℝ = 0
    ring
  have hd_zero : d = 0 := by
    obtain ⟨c, hcpos, hcoer⟩ := restrictedShiftedForm_isCoercive α μ
    have hcle : c * ‖d‖ * ‖d‖ ≤ 0 := (hcoer d).trans (le_of_eq (hd_test d))
    by_contra h0
    have hpos : 0 < c * ‖d‖ * ‖d‖ :=
      mul_pos (mul_pos hcpos (norm_pos_iff.mpr h0)) (norm_pos_iff.mpr h0)
    linarith
  have hL2 := congrArg (restrictedL2Map α) hd_zero
  rw [map_zero, map_sub, map_sub, map_smul, sub_eq_zero] at hL2
  simpa only [sub_apply, smul_apply,
    ContinuousLinearMap.comp_apply, restrictedResolventOp, uμ, uν, w] using hL2

/-- Hille--Yosida contraction estimate `‖R_μ‖ ≤ μ⁻¹`. -/
theorem opNorm_restrictedResolventOp_le (α : ℝ) (μ : PositiveShift) :
    ‖restrictedResolventOp α μ‖ ≤ (μ : ℝ)⁻¹ := by
  refine ContinuousLinearMap.opNorm_le_bound _ (inv_nonneg.mpr μ.2.le) fun f => ?_
  let u := restrictedResolventSol α μ f
  have hid := restrictedGagliardoForm_resolventSol α μ f u
  have hform : 0 ≤ (restrictedGagliardoForm α).form u u :=
    (restrictedGagliardoForm α).accretive u
  have hquad :
      (μ : ℝ) * ‖restrictedResolventOp α μ f‖ ^ 2 ≤ ‖f‖ * ‖restrictedResolventOp α μ f‖ := by
    have h1 : (μ : ℝ) * ‖restrictedResolventOp α μ f‖ ^ 2 ≤
        (restrictedGagliardoForm α).form u u +
          (μ : ℝ) * ⟪restrictedResolventOp α μ f, restrictedL2Map α u⟫_ℝ := by
      rw [← real_inner_self_eq_norm_sq]
      change (μ : ℝ) * ⟪restrictedL2Map α u, restrictedL2Map α u⟫_ℝ ≤
        (restrictedGagliardoForm α).form u u +
          (μ : ℝ) * ⟪restrictedL2Map α u, restrictedL2Map α u⟫_ℝ
      linarith
    have h2 : ⟪f, restrictedL2Map α u⟫_ℝ ≤ ‖f‖ * ‖restrictedResolventOp α μ f‖ := by
      change ⟪f, restrictedResolventOp α μ f⟫_ℝ ≤ _
      exact real_inner_le_norm _ _
    linarith
  by_cases hz : ‖restrictedResolventOp α μ f‖ = 0
  · rw [hz]
    exact mul_nonneg (inv_nonneg.mpr μ.2.le) (norm_nonneg f)
  · have hpos : 0 < ‖restrictedResolventOp α μ f‖ :=
      lt_of_le_of_ne (norm_nonneg _) (Ne.symm hz)
    have hmul : (μ : ℝ) * ‖restrictedResolventOp α μ f‖ ≤ ‖f‖ := by
      nlinarith
    have hineq : (μ : ℝ) * ‖restrictedResolventOp α μ f‖ ≤ (μ : ℝ) * ((μ : ℝ)⁻¹ * ‖f‖) := by
      calc
        (μ : ℝ) * ‖restrictedResolventOp α μ f‖ ≤ ‖f‖ := hmul
        _ = (μ : ℝ) * ((μ : ℝ)⁻¹ * ‖f‖) := by
            rw [← mul_assoc, mul_inv_cancel₀ μ.2.ne', one_mul]
    exact le_of_mul_le_mul_left hineq μ.2

/-- Dense range of `restrictedResolventOp α μ` in `L²((0, ∞); ℝ)` for `α ∈ (0, 2)`. -/
theorem denseRange_restrictedResolventOp {α : ℝ} (hα : FractionalExponent α) (μ : PositiveShift) :
    DenseRange (restrictedResolventOp α μ) := by
  rw [DenseRange]
  have hcls : ((restrictedResolventOp α μ).range : Submodule ℝ L2IoiR).topologicalClosure = ⊤ := by
    rw [Submodule.topologicalClosure_eq_top_iff, Submodule.eq_bot_iff]
    intro g hg
    let u := restrictedResolventSol α μ g
    have h0 : restrictedShiftedForm α μ u u = 0 := by
      rw [restrictedShiftedForm_resolventSol α μ g u, real_inner_comm]
      exact hg (restrictedResolventOp α μ g) ⟨g, rfl⟩
    obtain ⟨c, hcpos, hcoer⟩ := restrictedShiftedForm_isCoercive α μ
    have hu0 : u = 0 := by
      have hcle : c * ‖u‖ * ‖u‖ ≤ 0 := (hcoer u).trans (le_of_eq h0)
      by_contra hne
      have hpos : 0 < c * ‖u‖ * ‖u‖ :=
        mul_pos (mul_pos hcpos (norm_pos_iff.mpr hne)) (norm_pos_iff.mpr hne)
      linarith
    have hL2_orth : g ∈ ((restrictedL2Map α).range : Submodule ℝ L2IoiR)ᗮ := by
      rintro _ ⟨v, rfl⟩
      rw [real_inner_comm]
      change ⟪g, restrictedL2Map α v⟫_ℝ = 0
      rw [← restrictedShiftedForm_resolventSol α μ g v]
      change restrictedShiftedForm α μ u v = 0
      rw [hu0, map_zero, zero_apply]
    have hbot : ((restrictedL2Map α).range : Submodule ℝ L2IoiR)ᗮ = ⊥ := by
      rw [← Submodule.topologicalClosure_eq_top_iff]
      exact Submodule.eq_top_iff'.mpr fun y => by
        have hy : y ∈ closure (SetLike.coe ((restrictedL2Map α).range : Submodule ℝ L2IoiR)) :=
          (denseRange_restrictedL2Map hα).closure_range ▸ Set.mem_univ y
        exact hy
    rw [hbot] at hL2_orth
    exact hL2_orth
  change Dense (SetLike.coe ((restrictedResolventOp α μ).range : Submodule ℝ L2IoiR))
  rw [dense_iff_closure_eq]
  exact congrArg SetLike.coe hcls

/-- **Concrete Contractive Resolvent of the Restricted Fractional Laplacian** on `L²((0, ∞); ℝ)`:
for every `α ∈ (0, 2)`, `restrictedFracLapResolvent α hα` packages the Lax--Milgram resolvent
family `μ ↦ (μ + (-Δ)_{(0, ∞)}^{α / 2})⁻¹`. -/
noncomputable def restrictedFracLapResolvent (α : ℝ) (hα : FractionalExponent α) :
    ContractiveResolvent L2IoiR where
  operator μ := restrictedResolventOp α μ
  resolvent_identity := restrictedResolventOp_identity α
  opNorm_le_inv := opNorm_restrictedResolventOp_le α
  denseRange := denseRange_restrictedResolventOp hα

/-- **Concrete Restricted Fractional Heat `C₀`-Contraction Semigroup on `L²((0, ∞); ℝ)`**:
constructed from `restrictedFracLapResolvent α hα` via Yosida approximations and Hille--Yosida
(`ContractiveResolvent.generatedSemigroup`). -/
noncomputable def restrictedFracLapSemigroup (α : ℝ) (hα : FractionalExponent α) :
    StronglyContinuousContractionSemigroup L2IoiR :=
  (restrictedFracLapResolvent α hα).generatedSemigroup

/-- Exact Hille--Yosida identification: the Laplace-transform resolvent of
`restrictedFracLapSemigroup α hα` recovers `restrictedFracLapResolvent α hα`. -/
theorem restrictedFracLapSemigroup_resolvent_eq (α : ℝ) (hα : FractionalExponent α)
    (μ : PositiveShift) :
    (restrictedFracLapSemigroup α hα).resolvent μ = restrictedResolventOp α μ := by
  have h := ContractiveResolvent.toContractiveResolvent_generatedSemigroup
    (restrictedFracLapResolvent α hα)
  exact congrArg (fun R : ContractiveResolvent L2IoiR => R.operator μ) h

/-- Injectivity of `restrictedL2Map α`: if `ι u = 0` in `L²((0, ∞); ℝ)`, then `u = 0` in
`H^(α / 2)_0(0, ∞)`. -/
theorem restrictedL2Map_injective (α : ℝ) : Function.Injective (restrictedL2Map α) := by
  rw [injective_iff_map_eq_zero]
  intro u hu
  have hL2_norm0 : ‖restrictedL2Map α u‖ = 0 := by rw [hu, norm_zero]
  have hnorm_l2 : ‖gagliardoL2Part α u.1‖ = 0 := by
    have h2 : ‖restrictedL2Map α u‖ ^ 2 = ‖gagliardoL2Part α u.1‖ ^ 2 := by
      rw [← real_inner_self_eq_norm_sq, inner_restrictedL2Map_eq, real_inner_self_eq_norm_sq]
    rw [hL2_norm0, zero_pow two_ne_zero] at h2
    exact norm_eq_zero.mp (norm_eq_zero.mpr ((pow_eq_zero_iff two_ne_zero).mp h2.symm))
  have hL2_zero : gagliardoL2Part α u.1 = 0 := norm_eq_zero.mp hnorm_l2
  have hDiff_zero : gagliardoDiffPart α u.1 = 0 := by
    rw [Lp.ext_iff]
    have hae0 : (gagliardoL2Part α u.1 : ℝ → ℝ) =ᵐ[volume] 0 := by
      rw [hL2_zero]
      exact Lp.coeFn_zero ℝ 2 volume
    filter_upwards [u.1.2, ae_fst_gagliardoMeasure hae0, ae_snd_gagliardoMeasure hae0,
      Lp.coeFn_zero ℝ 2 (gagliardoMeasure α)] with p hp h1 h2 hz
    have hp' : (gagliardoDiffPart α u.1 : ℝ × ℝ → ℝ) p =
        (gagliardoL2Part α u.1 : ℝ → ℝ) p.1 - (gagliardoL2Part α u.1 : ℝ → ℝ) p.2 := hp
    have h1' : (gagliardoL2Part α u.1 : ℝ → ℝ) p.1 = 0 := h1
    have h2' : (gagliardoL2Part α u.1 : ℝ → ℝ) p.2 = 0 := h2
    rw [hp', h1', h2', sub_zero, hz]
    rfl
  have hform0 : (restrictedGagliardoForm α).form u u = 0 := by
    change ⟪gagliardoDiffPart α u.1, gagliardoDiffPart α u.1⟫_ℝ = 0
    rw [hDiff_zero, inner_zero_left]
  have hnorm_sq : ‖u‖ ^ 2 = 0 := by
    rw [norm_sq_restrictedGagliardoSpace, hL2_norm0, hform0]
    norm_num
  exact norm_eq_zero.mp ((pow_eq_zero_iff two_ne_zero).mp hnorm_sq)

/-- **Forward weak-form characterization of the restricted generator (`prop:formoperator`,
`thm:s0_generates`)**: every `u ∈ D(A₀)` lies in the range `ι (H^(α / 2)_0(0, ∞))`, and its
preimage `u'` satisfies `B^α_0(u', v) = ⟨-A₀ u, ι v⟩_{L²(0, ∞)}` for all
`v ∈ H^(α / 2)_0(0, ∞)`. -/
theorem restrictedFracLapSemigroup_mem_generatorDomain_forward {α : ℝ} (hα : FractionalExponent α)
    {u : L2IoiR} (hu : u ∈ (restrictedFracLapSemigroup α hα).generatorDomain) :
    ∃ u' : RestrictedGagliardoSpace α,
      restrictedL2Map α u' = u ∧
      ∀ v : RestrictedGagliardoSpace α,
        (restrictedGagliardoForm α).form u' v =
          ⟪-((restrictedFracLapSemigroup α hα).generator ⟨u, hu⟩), restrictedL2Map α v⟫_ℝ := by
  let μ₁ : PositiveShift := ⟨1, Set.mem_Ioi.mpr one_pos⟩
  have hμ₁ : (μ₁ : ℝ) = 1 := rfl
  have hrange : u ∈ Set.range ((restrictedFracLapResolvent α hα).operator μ₁) := by
    rw [← (restrictedFracLapResolvent α hα).generatorDomain_eq_range μ₁]
    exact hu
  rcases hrange with ⟨g, hgu⟩
  let u' : RestrictedGagliardoSpace α := restrictedResolventSol α μ₁ g
  refine ⟨u', hgu, fun v => ?_⟩
  have hgen :
      (restrictedFracLapSemigroup α hα).generator ⟨u, hu⟩ = (1 : ℝ) • u - g :=
    (restrictedFracLapResolvent α hα).generator_apply_of_operator_eq μ₁ hu hgu
  have hform := restrictedGagliardoForm_resolventSol α μ₁ g v
  have hL2 : restrictedResolventOp α μ₁ g = u := hgu
  rw [hL2, hμ₁, one_mul] at hform
  rw [hgen, one_smul, neg_sub, inner_sub_left]
  change (restrictedGagliardoForm α).form u' v =
    ⟪g, restrictedL2Map α v⟫_ℝ - ⟪u, restrictedL2Map α v⟫_ℝ
  linarith

/-- **Converse weak-form characterization of the restricted generator (`prop:formoperator`,
`thm:s0_generates`)**: if `u = ι u'` and `B^α_0(u', v) = ⟨f, ι v⟩_{L²(0, ∞)}` for all
`v ∈ H^(α / 2)_0(0, ∞)`, then `u ∈ D(A₀)` and `A₀ u = -f`. -/
theorem restrictedFracLapSemigroup_mem_generatorDomain_of_weakForm {α : ℝ}
    (hα : FractionalExponent α) {u f : L2IoiR} (u' : RestrictedGagliardoSpace α)
    (hu : restrictedL2Map α u' = u)
    (hform : ∀ v : RestrictedGagliardoSpace α,
      (restrictedGagliardoForm α).form u' v = ⟪f, restrictedL2Map α v⟫_ℝ) :
    ∃ hdom : u ∈ (restrictedFracLapSemigroup α hα).generatorDomain,
      (restrictedFracLapSemigroup α hα).generator ⟨u, hdom⟩ = -f := by
  let μ₁ : PositiveShift := ⟨1, Set.mem_Ioi.mpr one_pos⟩
  have hμ₁ : (μ₁ : ℝ) = 1 := rfl
  let g : L2IoiR := u + f
  have hsol : restrictedResolventSol α μ₁ g = u' := by
    let d : RestrictedGagliardoSpace α := restrictedResolventSol α μ₁ g - u'
    have hd : ∀ v : RestrictedGagliardoSpace α, restrictedShiftedForm α μ₁ d v = 0 := by
      intro v
      rw [show d = restrictedResolventSol α μ₁ g - u' from rfl, map_sub, sub_apply,
        restrictedShiftedForm_resolventSol α μ₁ g v, restrictedShiftedForm_apply, hform v, hu, hμ₁,
        one_mul]
      simp only [g, inner_add_left]
      ring
    obtain ⟨c, hcpos, hcoer⟩ := restrictedShiftedForm_isCoercive α μ₁
    have hd0 : d = 0 := by
      have hcle : c * ‖d‖ * ‖d‖ ≤ 0 := (hcoer d).trans (le_of_eq (hd d))
      by_contra hne
      have hpos : 0 < c * ‖d‖ * ‖d‖ :=
        mul_pos (mul_pos hcpos (norm_pos_iff.mpr hne)) (norm_pos_iff.mpr hne)
      linarith
    exact sub_eq_zero.mp hd0
  have hRu : (restrictedFracLapResolvent α hα).operator μ₁ g = u := by
    change restrictedResolventOp α μ₁ g = u
    unfold restrictedResolventOp
    rw [ContinuousLinearMap.comp_apply, hsol, hu]
  have hdom : u ∈ (restrictedFracLapSemigroup α hα).generatorDomain := by
    rw [← hRu]
    exact (restrictedFracLapResolvent α hα).operator_mem_generatorDomain μ₁ g
  refine ⟨hdom, ?_⟩
  change (restrictedFracLapResolvent α hα).generatedSemigroup.generator ⟨u, hdom⟩ = -f
  rw [(restrictedFracLapResolvent α hα).generator_apply_of_operator_eq μ₁ hdom hRu, hμ₁, one_smul]
  simp only [g, sub_add_cancel_left]

/-- **Friedrichs Weak-Form Generator Domain Equivalence (`prop:formoperator`,
`thm:s0_generates`)**:
`u ∈ D(A₀)` iff there exist `u' ∈ H^(α / 2)_0(0, ∞)` and `f ∈ L²((0, ∞); ℝ)` such that `ι u' = u`
and `B^α_0(u', v) = ⟨f, ι v⟩_{L²}` for all `v ∈ H^(α / 2)_0(0, ∞)`. -/
theorem restrictedFracLapSemigroup_mem_generatorDomain_iff {α : ℝ} (hα : FractionalExponent α)
    (u : L2IoiR) :
    u ∈ (restrictedFracLapSemigroup α hα).generatorDomain ↔
      ∃ (u' : RestrictedGagliardoSpace α) (f : L2IoiR),
        restrictedL2Map α u' = u ∧
        ∀ v : RestrictedGagliardoSpace α,
          (restrictedGagliardoForm α).form u' v = ⟪f, restrictedL2Map α v⟫_ℝ := by
  constructor
  · intro hu
    obtain ⟨u', hu', hform⟩ := restrictedFracLapSemigroup_mem_generatorDomain_forward hα hu
    exact ⟨u', -((restrictedFracLapSemigroup α hα).generator ⟨u, hu⟩), hu', hform⟩
  · rintro ⟨u', f, hu', hform⟩
    exact (restrictedFracLapSemigroup_mem_generatorDomain_of_weakForm hα u' hu' hform).1

/-- Dissipativity and energy identity for `A₀`: if `u = ι u' ∈ D(A₀)`, then
`⟨A₀ u, u⟩_{L²} = -B^α_0(u', u') ≤ 0`. -/
theorem inner_generator_restrictedFracLapSemigroup_eq_neg_form {α : ℝ}
    (hα : FractionalExponent α) {u : L2IoiR}
    (hu : u ∈ (restrictedFracLapSemigroup α hα).generatorDomain)
    (u' : RestrictedGagliardoSpace α) (hu' : restrictedL2Map α u' = u) :
    ⟪(restrictedFracLapSemigroup α hα).generator ⟨u, hu⟩, u⟫_ℝ =
      -(restrictedGagliardoForm α).form u' u' := by
  obtain ⟨w, hw, hform⟩ := restrictedFracLapSemigroup_mem_generatorDomain_forward hα hu
  have heq : w = u' := restrictedL2Map_injective α (hw.trans hu'.symm)
  subst heq
  have hneg := hform w
  rw [hw, inner_neg_left] at hneg
  linarith

/-- Self-adjointness / symmetry of the restricted generator `A₀` on `D(A₀)`. -/
theorem inner_generator_restrictedFracLapSemigroup_symm {α : ℝ} (hα : FractionalExponent α)
    {u v : L2IoiR}
    (hu : u ∈ (restrictedFracLapSemigroup α hα).generatorDomain)
    (hv : v ∈ (restrictedFracLapSemigroup α hα).generatorDomain) :
    ⟪(restrictedFracLapSemigroup α hα).generator ⟨u, hu⟩, v⟫_ℝ =
      ⟪u, (restrictedFracLapSemigroup α hα).generator ⟨v, hv⟩⟫_ℝ := by
  obtain ⟨u', hu', hform_u⟩ := restrictedFracLapSemigroup_mem_generatorDomain_forward hα hu
  obtain ⟨v', hv', hform_v⟩ := restrictedFracLapSemigroup_mem_generatorDomain_forward hα hv
  have h1 := hform_u v'
  have h2 := hform_v u'
  rw [hv', inner_neg_left] at h1
  rw [hu', inner_neg_left, real_inner_comm] at h2
  have hsym := (restrictedGagliardoForm α).symm u' v'
  linarith

/-! ### 3. Beurling--Deny positivity and sub-Markov `L^∞`-contractivity -/

/-- Closedness in `L²((0, ∞); ℝ)` of any pointwise a.e. closed predicate `P : ℝ → Prop`. -/
theorem isClosed_ae_mem_L2IoiR {P : ℝ → Prop} (hP : IsClosed {y : ℝ | P y}) :
    IsClosed {f : L2IoiR | ∀ᵐ x : ℝ ∂(volume : Measure ℝ).restrict (Ioi (0 : ℝ)),
      P ((f : ℝ → ℝ) x)} := by
  refine IsSeqClosed.isClosed fun seq lim hmem htend => ?_
  have hmeas :
      TendstoInMeasure ((volume : Measure ℝ).restrict (Ioi (0 : ℝ)))
        (fun n : ℕ => (seq n : ℝ → ℝ)) atTop (lim : ℝ → ℝ) := by
    refine tendstoInMeasure_of_tendsto_eLpNorm (p := 2) (by norm_num) ?_
    have heq :
        (fun n : ℕ =>
            eLpNorm ((seq n : ℝ → ℝ) - (lim : ℝ → ℝ)) 2
              ((volume : Measure ℝ).restrict (Ioi (0 : ℝ)))) =
          fun n : ℕ => ENNReal.ofReal (dist (seq n) lim) := by
      funext n
      rw [← Lp.edist_def, Lp.edist_dist]
    rw [heq]
    simpa only [Function.comp_def, ENNReal.ofReal_zero] using
      ENNReal.continuous_ofReal.continuousAt.tendsto.comp
        (tendsto_iff_dist_tendsto_zero.mp htend)
  obtain ⟨φ, hφ_mono, hφ_ae⟩ := hmeas.exists_seq_tendsto_ae
  have hae_all :
      ∀ᵐ x : ℝ ∂(volume : Measure ℝ).restrict (Ioi (0 : ℝ)),
        ∀ k : ℕ, P ((seq (φ k) : ℝ → ℝ) x) :=
    ae_all_iff.mpr fun k => hmem (φ k)
  filter_upwards [hae_all, hφ_ae] with x hxk hlim
  exact hP.mem_of_tendsto hlim (Filter.Eventually.of_forall hxk)

/-- Pointwise a.e. nonnegativity is preserved by `restrictedResolventOp α μ`. -/
theorem restrictedResolventOp_ae_nonneg {α : ℝ} (hα : FractionalExponent α) (μ : PositiveShift)
    {f : L2IoiR} (hf : ∀ᵐ x : ℝ ∂(volume : Measure ℝ).restrict (Ioi (0 : ℝ)),
      0 ≤ (f : ℝ → ℝ) x) :
    ∀ᵐ x : ℝ ∂(volume : Measure ℝ).restrict (Ioi (0 : ℝ)),
      0 ≤ (restrictedResolventOp α μ f : ℝ → ℝ) x := by
  let u : RestrictedGagliardoSpace α := restrictedResolventSol α μ f
  let uAbs : RestrictedGagliardoSpace α := restrictedGagliardoAbs α u
  let w : RestrictedGagliardoSpace α := uAbs - u
  have hB_le :
      (restrictedGagliardoForm α).form uAbs uAbs ≤ (restrictedGagliardoForm α).form u u :=
    (restrictedGagliardoForm_isMarkovDirichletForm hα).form_abs_le u
  have hL2_abs :
      ‖restrictedL2Map α uAbs‖ ^ 2 = ‖restrictedL2Map α u‖ ^ 2 := by
    rw [← real_inner_self_eq_norm_sq, ← real_inner_self_eq_norm_sq,
      inner_restrictedL2Map_eq, inner_restrictedL2Map_eq, L2.inner_def, L2.inner_def]
    refine integral_congr_ae ?_
    filter_upwards [coeFn_gagliardoCompLip_l2Part α lipschitzWith_abs_real abs_zero u.1] with x hx
    have hx' : (gagliardoL2Part α uAbs.1 : ℝ → ℝ) x = |(gagliardoL2Part α u.1 : ℝ → ℝ) x| := hx
    rw [hx', real_inner_self_eq_norm_sq, real_inner_self_eq_norm_sq, Real.norm_eq_abs, sq_abs,
      Real.norm_eq_abs, sq_abs]
  have hS_le : restrictedShiftedForm α μ uAbs uAbs ≤ restrictedShiftedForm α μ u u := by
    rw [restrictedShiftedForm_apply, restrictedShiftedForm_apply,
      real_inner_self_eq_norm_sq, real_inner_self_eq_norm_sq, hL2_abs]
    linarith
  have hw_nonneg_vol : ∀ᵐ x : ℝ ∂volume, 0 ≤ (gagliardoL2Part α w.1 : ℝ → ℝ) x := by
    filter_upwards [Lp.coeFn_sub (gagliardoL2Part α uAbs.1) (gagliardoL2Part α u.1),
      coeFn_gagliardoCompLip_l2Part α lipschitzWith_abs_real abs_zero u.1] with x hsub habs
    have hsub' : (gagliardoL2Part α w.1 : ℝ → ℝ) x =
        (gagliardoL2Part α uAbs.1 : ℝ → ℝ) x - (gagliardoL2Part α u.1 : ℝ → ℝ) x := hsub
    have habs' : (gagliardoL2Part α uAbs.1 : ℝ → ℝ) x = |(gagliardoL2Part α u.1 : ℝ → ℝ) x| := habs
    rw [hsub', habs']
    linarith [le_abs_self ((gagliardoL2Part α u.1 : ℝ → ℝ) x)]
  have hw_nonneg_Ioi :
      ∀ᵐ x : ℝ ∂(volume : Measure ℝ).restrict (Ioi (0 : ℝ)),
        0 ≤ (restrictedL2Map α w : ℝ → ℝ) x := by
    filter_upwards [coeFn_restIoiR (gagliardoL2Part α w.1),
      ae_restrict_of_ae hw_nonneg_vol] with x h1 h2
    exact h1 ▸ h2
  have hinner_nonneg : 0 ≤ ⟪f, restrictedL2Map α w⟫_ℝ := by
    rw [L2.inner_def]
    refine integral_nonneg_of_ae ?_
    filter_upwards [hf, hw_nonneg_Ioi] with x hfx hwx
    exact mul_nonneg hwx hfx
  have hSw_le : restrictedShiftedForm α μ w w ≤ 0 := by
    have hlin :
        restrictedShiftedForm α μ w w =
          restrictedShiftedForm α μ uAbs uAbs - restrictedShiftedForm α μ uAbs u -
            (restrictedShiftedForm α μ u uAbs - restrictedShiftedForm α μ u u) := by
      simp only [w, map_sub, sub_apply]
      rw [restrictedShiftedForm_symm α μ u uAbs]
    have huw :
        restrictedShiftedForm α μ u w =
          restrictedShiftedForm α μ u uAbs - restrictedShiftedForm α μ u u :=
      map_sub (restrictedShiftedForm α μ u) uAbs u
    have hexpand :
        restrictedShiftedForm α μ w w =
          (restrictedShiftedForm α μ uAbs uAbs - restrictedShiftedForm α μ u u) -
            2 * restrictedShiftedForm α μ u w := by
      rw [hlin, huw, restrictedShiftedForm_symm α μ uAbs u]
      ring
    rw [hexpand, restrictedShiftedForm_resolventSol α μ f w]
    linarith
  obtain ⟨c, hcpos, hcoer⟩ := restrictedShiftedForm_isCoercive α μ
  have hw0 : w = 0 := by
    have hcle : c * ‖w‖ * ‖w‖ ≤ 0 := (hcoer w).trans hSw_le
    by_contra hne
    have hpos : 0 < c * ‖w‖ * ‖w‖ :=
      mul_pos (mul_pos hcpos (norm_pos_iff.mpr hne)) (norm_pos_iff.mpr hne)
    linarith
  have habs_eq : (gagliardoL2Part α uAbs.1 : ℝ → ℝ) =ᵐ[volume] (gagliardoL2Part α u.1 : ℝ → ℝ) := by
    have hsub0 :
        (gagliardoL2Part α uAbs.1 : ℝ → ℝ) - (gagliardoL2Part α u.1 : ℝ → ℝ) =ᵐ[volume] 0 := by
      have hwL2 : gagliardoL2Part α w.1 = 0 := by rw [hw0]; simp
      filter_upwards [Lp.coeFn_sub (gagliardoL2Part α uAbs.1) (gagliardoL2Part α u.1),
        Lp.coeFn_zero ℝ 2 volume] with x hsub hzero
      have h1 : (gagliardoL2Part α uAbs.1 : ℝ → ℝ) x - (gagliardoL2Part α u.1 : ℝ → ℝ) x =
          (gagliardoL2Part α w.1 : ℝ → ℝ) x := hsub.symm
      rw [Pi.sub_apply, h1, hwL2]
      exact hzero
    filter_upwards [hsub0] with x hx
    exact sub_eq_zero.mp hx
  filter_upwards [coeFn_restIoiR (gagliardoL2Part α u.1),
    ae_restrict_of_ae (coeFn_gagliardoCompLip_l2Part α lipschitzWith_abs_real abs_zero u.1),
    ae_restrict_of_ae habs_eq] with x h1 h2 h3
  have hres : (restrictedResolventOp α μ f : ℝ → ℝ) x = (gagliardoL2Part α u.1 : ℝ → ℝ) x := h1
  have h2' : (gagliardoL2Part α uAbs.1 : ℝ → ℝ) x = |(gagliardoL2Part α u.1 : ℝ → ℝ) x| := h2
  rw [hres, ← h3, h2']
  exact abs_nonneg _

/-- Pointwise `1`-Lipschitz property of `t ↦ min t M`. -/
theorem lipschitzWith_min_const_real (M : ℝ) : LipschitzWith 1 (fun t : ℝ => min t M) :=
  LipschitzWith.of_dist_le_mul fun a b => by
    rw [Real.dist_eq, Real.dist_eq, NNReal.coe_one, one_mul]
    rcases le_total a M with ha | ha <;> rcases le_total b M with hb | hb
    · rw [min_eq_left ha, min_eq_left hb]
    · rw [min_eq_left ha, min_eq_right hb]
      rw [abs_of_nonpos (by linarith), abs_of_nonpos (by linarith)]
      linarith
    · rw [min_eq_right ha, min_eq_left hb]
      rw [abs_of_nonneg (by linarith), abs_of_nonneg (by linarith)]
      linarith
    · rw [min_eq_right ha, min_eq_right hb, sub_self, abs_zero]
      exact abs_nonneg _

/-- Scalar sub-Markov bound for the resolvent: if `f ≤ (μ : ℝ) * c` a.e. on `(0, ∞)` with `c ≥ 0`,
then `restrictedResolventOp α μ f ≤ c` a.e. on `(0, ∞)`. -/
theorem restrictedResolventOp_ae_le_of_le_mul {α : ℝ} (μ : PositiveShift)
    {c : ℝ} (hc : 0 ≤ c) {f : L2IoiR}
    (hf : ∀ᵐ x : ℝ ∂(volume : Measure ℝ).restrict (Ioi (0 : ℝ)),
      (f : ℝ → ℝ) x ≤ (μ : ℝ) * c) :
    ∀ᵐ x : ℝ ∂(volume : Measure ℝ).restrict (Ioi (0 : ℝ)),
      (restrictedResolventOp α μ f : ℝ → ℝ) x ≤ c := by
  let u : RestrictedGagliardoSpace α := restrictedResolventSol α μ f
  let uc : RestrictedGagliardoSpace α :=
    restrictedGagliardoCompLip α (lipschitzWith_min_const_real c) (min_eq_left hc) u
  let w : RestrictedGagliardoSpace α := u - uc
  have huc_coe := coeFn_gagliardoCompLip_l2Part α (lipschitzWith_min_const_real c)
    (min_eq_left hc) u.1
  have hw_coe :
      (gagliardoL2Part α w.1 : ℝ → ℝ) =ᵐ[volume]
        fun x => (gagliardoL2Part α u.1 : ℝ → ℝ) x - min ((gagliardoL2Part α u.1 : ℝ → ℝ) x) c := by
    filter_upwards [Lp.coeFn_sub (gagliardoL2Part α u.1) (gagliardoL2Part α uc.1),
      huc_coe] with x hsub hmin
    have hsub' : (gagliardoL2Part α w.1 : ℝ → ℝ) x =
        (gagliardoL2Part α u.1 : ℝ → ℝ) x - (gagliardoL2Part α uc.1 : ℝ → ℝ) x := hsub
    have hmin' : (gagliardoL2Part α uc.1 : ℝ → ℝ) x =
        min ((gagliardoL2Part α u.1 : ℝ → ℝ) x) c := hmin
    rw [hsub', hmin']
  have hform_uc_w : 0 ≤ (restrictedGagliardoForm α).form uc w := by
    change 0 ≤ ⟪gagliardoDiffPart α uc.1, gagliardoDiffPart α w.1⟫_ℝ
    rw [L2.inner_def]
    refine integral_nonneg_of_ae ?_
    filter_upwards [uc.1.2, w.1.2, ae_fst_gagliardoMeasure huc_coe,
      ae_snd_gagliardoMeasure huc_coe, ae_fst_gagliardoMeasure hw_coe,
      ae_snd_gagliardoMeasure hw_coe] with p hpuc hpw huc1 huc2 hw1 hw2
    have huc1' : (gagliardoL2Part α uc.1 : ℝ → ℝ) p.1 =
        min ((gagliardoL2Part α u.1 : ℝ → ℝ) p.1) c := huc1
    have huc2' : (gagliardoL2Part α uc.1 : ℝ → ℝ) p.2 =
        min ((gagliardoL2Part α u.1 : ℝ → ℝ) p.2) c := huc2
    have hduc : (gagliardoDiffPart α uc.1 : ℝ × ℝ → ℝ) p =
        min ((gagliardoL2Part α u.1 : ℝ → ℝ) p.1) c -
          min ((gagliardoL2Part α u.1 : ℝ → ℝ) p.2) c := by
      have hp' : (gagliardoDiffPart α uc.1 : ℝ × ℝ → ℝ) p =
          (gagliardoL2Part α uc.1 : ℝ → ℝ) p.1 - (gagliardoL2Part α uc.1 : ℝ → ℝ) p.2 := hpuc
      rw [hp', huc1', huc2']
    have hdw : (gagliardoDiffPart α w.1 : ℝ × ℝ → ℝ) p =
        ((gagliardoL2Part α u.1 : ℝ → ℝ) p.1 - min ((gagliardoL2Part α u.1 : ℝ → ℝ) p.1) c) -
          ((gagliardoL2Part α u.1 : ℝ → ℝ) p.2 - min ((gagliardoL2Part α u.1 : ℝ → ℝ) p.2) c) := by
      have hp' : (gagliardoDiffPart α w.1 : ℝ × ℝ → ℝ) p =
          (gagliardoL2Part α w.1 : ℝ → ℝ) p.1 - (gagliardoL2Part α w.1 : ℝ → ℝ) p.2 := hpw
      rw [hp', hw1, hw2]
    change 0 ≤ ((gagliardoDiffPart α w.1 : ℝ × ℝ → ℝ) p) *
      ((gagliardoDiffPart α uc.1 : ℝ × ℝ → ℝ) p)
    rw [hduc, hdw]
    set a := (gagliardoL2Part α u.1 : ℝ → ℝ) p.1
    set b := (gagliardoL2Part α u.1 : ℝ → ℝ) p.2
    rcases le_total a c with ha | ha <;> rcases le_total b c with hb | hb
    · rw [min_eq_left ha, min_eq_left hb]; norm_num
    · rw [min_eq_left ha, min_eq_right hb]
      nlinarith
    · rw [min_eq_right ha, min_eq_left hb]
      nlinarith
    · rw [min_eq_right ha, min_eq_right hb]; norm_num
  have hBww_le : (restrictedGagliardoForm α).form w w ≤ (restrictedGagliardoForm α).form u w := by
    have hu_split : u = uc + w := by simp [w]
    have heq : (restrictedGagliardoForm α).form u w =
        (restrictedGagliardoForm α).form uc w + (restrictedGagliardoForm α).form w w := by
      change ⟪gagliardoDiffPart α u.1, gagliardoDiffPart α w.1⟫_ℝ =
        ⟪gagliardoDiffPart α uc.1, gagliardoDiffPart α w.1⟫_ℝ +
          ⟪gagliardoDiffPart α w.1, gagliardoDiffPart α w.1⟫_ℝ
      rw [hu_split, Submodule.coe_add, map_add, inner_add_left]
    linarith
  have hw_Ioi :
      (restrictedL2Map α w : ℝ → ℝ) =ᵐ[(volume : Measure ℝ).restrict (Ioi (0 : ℝ))]
        fun x => (restrictedResolventOp α μ f : ℝ → ℝ) x -
          min ((restrictedResolventOp α μ f : ℝ → ℝ) x) c := by
    filter_upwards [coeFn_restIoiR (gagliardoL2Part α w.1),
      coeFn_restIoiR (gagliardoL2Part α u.1), ae_restrict_of_ae hw_coe] with x h1 h2 h3
    change (restIoiR (gagliardoL2Part α w.1) : ℝ → ℝ) x = _
    rw [h1, h3]
    change (gagliardoL2Part α u.1 : ℝ → ℝ) x - min ((gagliardoL2Part α u.1 : ℝ → ℝ) x) c =
      (restIoiR (gagliardoL2Part α u.1) : ℝ → ℝ) x -
        min ((restIoiR (gagliardoL2Part α u.1) : ℝ → ℝ) x) c
    rw [h2]
  have hint_mono :
      ∫ x : ℝ, ((f : ℝ → ℝ) x - (μ : ℝ) * (restrictedResolventOp α μ f : ℝ → ℝ) x) *
          (restrictedL2Map α w : ℝ → ℝ) x ∂((volume : Measure ℝ).restrict (Ioi (0 : ℝ))) ≤
        ∫ x : ℝ, -((μ : ℝ) * ((restrictedL2Map α w : ℝ → ℝ) x) ^ 2)
          ∂((volume : Measure ℝ).restrict (Ioi (0 : ℝ))) := by
    have hint1 :
        Integrable
          (fun x : ℝ =>
            ((f : ℝ → ℝ) x - (μ : ℝ) * (restrictedResolventOp α μ f : ℝ → ℝ) x) *
              (restrictedL2Map α w : ℝ → ℝ) x)
          ((volume : Measure ℝ).restrict (Ioi (0 : ℝ))) :=
      ((Lp.memLp f).sub ((Lp.memLp (restrictedResolventOp α μ f)).const_mul (μ : ℝ))).integrable_mul
        (Lp.memLp (restrictedL2Map α w))
    have hint2 :
        Integrable
          (fun x : ℝ => -((μ : ℝ) * ((restrictedL2Map α w : ℝ → ℝ) x) ^ 2))
          ((volume : Measure ℝ).restrict (Ioi (0 : ℝ))) :=
      (((memLp_two_iff_integrable_sq (Lp.aestronglyMeasurable _)).mp
        (Lp.memLp (restrictedL2Map α w))).const_mul (μ : ℝ)).neg
    refine integral_mono_ae hint1 hint2 ?_
    filter_upwards [hf, hw_Ioi] with x hfx hwx
    set ax := (restrictedResolventOp α μ f : ℝ → ℝ) x
    change ((f : ℝ → ℝ) x - (μ : ℝ) * ax) * (restrictedL2Map α w : ℝ → ℝ) x ≤
      -((μ : ℝ) * ((restrictedL2Map α w : ℝ → ℝ) x) ^ 2)
    rw [hwx]
    rcases le_total ax c with ha | ha
    · rw [min_eq_left ha]; norm_num
    · rw [min_eq_right ha]
      have hsub_nonneg : 0 ≤ ax - c := sub_nonneg.mpr ha
      have h1 : (f : ℝ → ℝ) x - (μ : ℝ) * ax ≤ (μ : ℝ) * c - (μ : ℝ) * ax := by linarith
      have h2 : ((f : ℝ → ℝ) x - (μ : ℝ) * ax) * (ax - c) ≤
          ((μ : ℝ) * c - (μ : ℝ) * ax) * (ax - c) :=
        mul_le_mul_of_nonneg_right h1 hsub_nonneg
      calc
        ((f : ℝ → ℝ) x - (μ : ℝ) * ax) * (ax - c)
            ≤ ((μ : ℝ) * c - (μ : ℝ) * ax) * (ax - c) := h2
        _ = -((μ : ℝ) * (ax - c) ^ 2) := by ring
  have hL_eq :
      ∫ x : ℝ, ((f : ℝ → ℝ) x - (μ : ℝ) * (restrictedResolventOp α μ f : ℝ → ℝ) x) *
          (restrictedL2Map α w : ℝ → ℝ) x ∂((volume : Measure ℝ).restrict (Ioi (0 : ℝ))) =
        (restrictedGagliardoForm α).form u w := by
    have hvar := restrictedGagliardoForm_resolventSol α μ f w
    have hfun :
        (fun x : ℝ =>
          ((f : ℝ → ℝ) x - (μ : ℝ) * (restrictedResolventOp α μ f : ℝ → ℝ) x) *
            (restrictedL2Map α w : ℝ → ℝ) x) =
          fun x : ℝ => (f : ℝ → ℝ) x * (restrictedL2Map α w : ℝ → ℝ) x -
            (μ : ℝ) * ((restrictedResolventOp α μ f : ℝ → ℝ) x *
              (restrictedL2Map α w : ℝ → ℝ) x) := by
      funext x
      ring
    rw [hfun, integral_sub
      (show Integrable (fun x : ℝ => (f : ℝ → ℝ) x * (restrictedL2Map α w : ℝ → ℝ) x)
          ((volume : Measure ℝ).restrict (Ioi (0 : ℝ))) from
        (Lp.memLp f).integrable_mul (Lp.memLp (restrictedL2Map α w)))
      (show Integrable
          (fun x : ℝ => (μ : ℝ) * ((restrictedResolventOp α μ f : ℝ → ℝ) x *
            (restrictedL2Map α w : ℝ → ℝ) x))
          ((volume : Measure ℝ).restrict (Ioi (0 : ℝ))) from
        ((Lp.memLp (restrictedResolventOp α μ f)).integrable_mul
          (Lp.memLp (restrictedL2Map α w))).const_mul (μ : ℝ)),
      integral_const_mul]
    have hf_in :
        ∫ x : ℝ, (f : ℝ → ℝ) x * (restrictedL2Map α w : ℝ → ℝ) x
          ∂((volume : Measure ℝ).restrict (Ioi (0 : ℝ))) =
          ⟪f, restrictedL2Map α w⟫_ℝ := by
      rw [L2.inner_def]
      refine integral_congr_ae (Filter.Eventually.of_forall fun x => ?_)
      change (f : ℝ → ℝ) x * (restrictedL2Map α w : ℝ → ℝ) x =
        (restrictedL2Map α w : ℝ → ℝ) x * (f : ℝ → ℝ) x
      ring
    have hu_in :
        ∫ x : ℝ, (restrictedResolventOp α μ f : ℝ → ℝ) x * (restrictedL2Map α w : ℝ → ℝ) x
          ∂((volume : Measure ℝ).restrict (Ioi (0 : ℝ))) =
          ⟪restrictedResolventOp α μ f, restrictedL2Map α w⟫_ℝ := by
      rw [L2.inner_def]
      refine integral_congr_ae (Filter.Eventually.of_forall fun x => ?_)
      change (restrictedResolventOp α μ f : ℝ → ℝ) x * (restrictedL2Map α w : ℝ → ℝ) x =
        (restrictedL2Map α w : ℝ → ℝ) x * (restrictedResolventOp α μ f : ℝ → ℝ) x
      ring
    rw [hf_in, hu_in]
    linarith
  have hR_eq :
      ∫ x : ℝ, -((μ : ℝ) * ((restrictedL2Map α w : ℝ → ℝ) x) ^ 2)
          ∂((volume : Measure ℝ).restrict (Ioi (0 : ℝ))) =
        -((μ : ℝ) * ‖restrictedL2Map α w‖ ^ 2) := by
    rw [integral_neg, integral_const_mul, ← real_inner_self_eq_norm_sq, L2.inner_def]
    congr 2
    refine integral_congr_ae (Filter.Eventually.of_forall fun x => ?_)
    change ((restrictedL2Map α w : ℝ → ℝ) x) ^ 2 =
      ((restrictedL2Map α w : ℝ → ℝ) x) * ((restrictedL2Map α w : ℝ → ℝ) x)
    ring
  rw [hL_eq, hR_eq] at hint_mono
  have hw_zero : restrictedL2Map α w = 0 := by
    have hacc : 0 ≤ (restrictedGagliardoForm α).form w w := (restrictedGagliardoForm α).accretive w
    by_contra hne
    have hpos : 0 < (μ : ℝ) * ‖restrictedL2Map α w‖ ^ 2 :=
      mul_pos μ.2 (pow_pos (norm_pos_iff.mpr hne) 2)
    linarith
  filter_upwards [hw_Ioi,
    Lp.coeFn_zero ℝ 2 ((volume : Measure ℝ).restrict (Ioi (0 : ℝ)))] with x h1 h2
  have hsub0 : (restrictedResolventOp α μ f : ℝ → ℝ) x -
      min ((restrictedResolventOp α μ f : ℝ → ℝ) x) c = 0 := by
    rw [← h1, hw_zero]
    exact h2
  exact le_of_eq_of_le (eq_of_sub_eq_zero hsub0) (min_le_right _ _)

/-- **Sub-Markovianity of the normalized resolvent `μ R_μ`**: if `f ≤ M` a.e. on `(0, ∞)` with
`M ≥ 0`, then `μ • R_μ f ≤ M` a.e. on `(0, ∞)`. -/
theorem restrictedResolventOp_ae_le {α : ℝ} (μ : PositiveShift) {M : ℝ} (hM : 0 ≤ M)
    {f : L2IoiR}
    (hf : ∀ᵐ x : ℝ ∂(volume : Measure ℝ).restrict (Ioi (0 : ℝ)), (f : ℝ → ℝ) x ≤ M) :
    ∀ᵐ x : ℝ ∂(volume : Measure ℝ).restrict (Ioi (0 : ℝ)),
      (((μ : ℝ) • restrictedResolventOp α μ f : L2IoiR) : ℝ → ℝ) x ≤ M := by
  have hc : 0 ≤ M / (μ : ℝ) := div_nonneg hM μ.2.le
  have hf' :
      ∀ᵐ x : ℝ ∂(volume : Measure ℝ).restrict (Ioi (0 : ℝ)),
        (f : ℝ → ℝ) x ≤ (μ : ℝ) * (M / (μ : ℝ)) := by
    rwa [mul_div_cancel₀ _ μ.2.ne']
  have hres := restrictedResolventOp_ae_le_of_le_mul (α := α) μ hc hf'
  filter_upwards [Lp.coeFn_smul (μ : ℝ) (restrictedResolventOp α μ f), hres] with x hsm hle
  have hsm' :
      (((μ : ℝ) • restrictedResolventOp α μ f : L2IoiR) : ℝ → ℝ) x =
        (μ : ℝ) * (restrictedResolventOp α μ f : ℝ → ℝ) x := hsm
  rw [hsm']
  calc
    (μ : ℝ) * (restrictedResolventOp α μ f : ℝ → ℝ) x ≤ (μ : ℝ) * (M / (μ : ℝ)) :=
      mul_le_mul_of_nonneg_left hle μ.2.le
    _ = M := mul_div_cancel₀ _ μ.2.ne'

private theorem hasSum_poisson_weights (c : ℝ) :
    HasSum (fun n : ℕ => Real.exp (-c) * (Nat.factorial n : ℝ)⁻¹ * c ^ n) 1 := by
  have h0 : HasSum (fun n : ℕ => (Nat.factorial n : ℝ)⁻¹ * c ^ n) (Real.exp c) := by
    rw [Real.exp_eq_exp_ℝ]
    simpa only [smul_eq_mul] using
      (NormedSpace.exp_series_hasSum_exp' (𝕂 := ℝ) (𝔸 := ℝ) c)
  have h1 := h0.mul_left (Real.exp (-c))
  have hmul : Real.exp (-c) * Real.exp c = 1 := by
    rw [Real.exp_neg]
    exact inv_mul_cancel₀ (Real.exp_pos c).ne'
  rw [hmul] at h1
  refine h1.congr_fun fun n => ?_
  ring

/-- Helper: invariance of a closed subset of `L²((0, ∞); ℝ)` of the form `{f | ∀ᵐ x, P (f x)}`
under the Yosida-generated semigroup whenever the scaled resolvent preserves it. -/
private theorem generatedSemigroup_ae_mem_of_scaledResolvent {R : ContractiveResolvent L2IoiR}
    {P : ℝ → Prop} (hP : IsClosed {y : ℝ | P y})
    (hsum : ∀ N : ℕ, ∀ w : ℕ → ℝ, (∀ n, 0 ≤ w n) → ∑ n ∈ Finset.range N, w n ≤ 1 →
      ∀ g : ℕ → L2IoiR, (∀ n, ∀ᵐ x : ℝ ∂(volume : Measure ℝ).restrict (Ioi (0 : ℝ)),
        P ((g n : ℝ → ℝ) x)) →
      ∀ᵐ x : ℝ ∂(volume : Measure ℝ).restrict (Ioi (0 : ℝ)),
        P (((∑ n ∈ Finset.range N, w n • g n : L2IoiR) : ℝ → ℝ) x))
    (hQ : ∀ (μ : PositiveShift) (f : L2IoiR),
      (∀ᵐ x : ℝ ∂(volume : Measure ℝ).restrict (Ioi (0 : ℝ)), P ((f : ℝ → ℝ) x)) →
      ∀ᵐ x : ℝ ∂(volume : Measure ℝ).restrict (Ioi (0 : ℝ)),
        P ((R.scaledOperator μ f : ℝ → ℝ) x))
    (t : ℝ≥0) {f : L2IoiR}
    (hf : ∀ᵐ x : ℝ ∂(volume : Measure ℝ).restrict (Ioi (0 : ℝ)), P ((f : ℝ → ℝ) x)) :
    ∀ᵐ x : ℝ ∂(volume : Measure ℝ).restrict (Ioi (0 : ℝ)),
      P ((R.generatedSemigroup t f : ℝ → ℝ) x) := by
  let S : Set L2IoiR :=
    {g : L2IoiR | ∀ᵐ x : ℝ ∂(volume : Measure ℝ).restrict (Ioi (0 : ℝ)), P ((g : ℝ → ℝ) x)}
  have hS_closed : IsClosed S := isClosed_ae_mem_L2IoiR hP
  have hyos : ∀ μ : PositiveShift, R.yosidaOperator μ t f ∈ S := by
    intro μ
    set c : ℝ := (t : ℝ) * (μ : ℝ)
    set w : ℕ → ℝ := fun n => Real.exp (-c) * (Nat.factorial n : ℝ)⁻¹ * c ^ n
    have hw_nn : ∀ n : ℕ, 0 ≤ w n := fun n => by
      dsimp only [w]
      have hc0 : 0 ≤ c := mul_nonneg t.coe_nonneg μ.2.le
      positivity
    have hpow : ∀ n : ℕ, (R.scaledOperator μ ^ n) f ∈ S := by
      intro n
      induction n with
      | zero =>
          change ∀ᵐ x : ℝ ∂(volume : Measure ℝ).restrict (Ioi (0 : ℝ)),
            P (((R.scaledOperator μ ^ 0) f : ℝ → ℝ) x)
          simpa only [pow_zero, one_apply_eq_self] using hf
      | succ n ih =>
          rw [pow_succ', mul_apply_eq_comp]
          exact hQ μ _ ih
    have htend :
        Tendsto (fun N : ℕ => ∑ n ∈ Finset.range N, w n • ((R.scaledOperator μ ^ n) f))
          atTop (nhds (R.yosidaOperator μ t f)) :=
      (R.hasSum_yosidaOperator_apply μ t f).tendsto_sum_nat
    refine hS_closed.mem_of_tendsto htend (Filter.Eventually.of_forall fun N => ?_)
    have hsum_le : ∑ n ∈ Finset.range N, w n ≤ 1 :=
      sum_le_hasSum (Finset.range N) (fun n _ => hw_nn n) (hasSum_poisson_weights c)
    exact hsum N w hw_nn hsum_le (fun n => (R.scaledOperator μ ^ n) f) hpow
  have hgen :
      Tendsto (fun n : ℕ => R.yosidaOperator (naturalShift n) t f)
        atTop (nhds (R.generatedSemigroup t f)) :=
    R.tendsto_yosidaOperator_naturalShift_apply t f
  exact hS_closed.mem_of_tendsto hgen (Filter.Eventually.of_forall fun n => hyos (naturalShift n))

private theorem ae_nonneg_finset_sum (N : ℕ) (w : ℕ → ℝ) (hw : ∀ n, 0 ≤ w n)
    (g : ℕ → L2IoiR)
    (hg : ∀ n, ∀ᵐ x : ℝ ∂(volume : Measure ℝ).restrict (Ioi (0 : ℝ)), 0 ≤ (g n : ℝ → ℝ) x) :
    ∀ᵐ x : ℝ ∂(volume : Measure ℝ).restrict (Ioi (0 : ℝ)),
      0 ≤ ((∑ n ∈ Finset.range N, w n • g n : L2IoiR) : ℝ → ℝ) x := by
  induction N with
  | zero =>
      simp only [Finset.range_zero, Finset.sum_empty]
      filter_upwards [Lp.coeFn_zero ℝ 2 ((volume : Measure ℝ).restrict (Ioi (0 : ℝ)))]
        with x hz
      rw [hz, Pi.zero_apply]
  | succ N ih =>
      rw [Finset.sum_range_succ]
      filter_upwards [ih, hg N,
        Lp.coeFn_add (∑ n ∈ Finset.range N, w n • g n) (w N • g N),
        Lp.coeFn_smul (w N) (g N)] with x h1 h2 hadd hsm
      have hadd' :
          (((∑ n ∈ Finset.range N, w n • g n) + w N • g N : L2IoiR) : ℝ → ℝ) x =
            ((∑ n ∈ Finset.range N, w n • g n : L2IoiR) : ℝ → ℝ) x +
              ((w N • g N : L2IoiR) : ℝ → ℝ) x := hadd
      have hsm' : ((w N • g N : L2IoiR) : ℝ → ℝ) x = w N * (g N : ℝ → ℝ) x := hsm
      rw [hadd', hsm']
      exact add_nonneg h1 (mul_nonneg (hw N) h2)

/-- **Positivity Preservation of the Restricted Semigroup `S₀(t)`**:
if `f ≥ 0` a.e. on `(0, ∞)`, then `(restrictedFracLapSemigroup α hα t f) ≥ 0` a.e. on `(0, ∞)`
for all `t ≥ 0`. -/
theorem restrictedFracLapSemigroup_ae_nonneg {α : ℝ} (hα : FractionalExponent α) (t : ℝ≥0)
    {f : L2IoiR} (hf : ∀ᵐ x : ℝ ∂(volume : Measure ℝ).restrict (Ioi (0 : ℝ)),
      0 ≤ (f : ℝ → ℝ) x) :
    ∀ᵐ x : ℝ ∂(volume : Measure ℝ).restrict (Ioi (0 : ℝ)),
      0 ≤ (restrictedFracLapSemigroup α hα t f : ℝ → ℝ) x := by
  refine generatedSemigroup_ae_mem_of_scaledResolvent isClosed_Ici ?_ ?_ t hf
  · intro N w hw _ g hg
    exact ae_nonneg_finset_sum N w hw g hg
  · intro μ u hu
    change ∀ᵐ x : ℝ ∂(volume : Measure ℝ).restrict (Ioi (0 : ℝ)),
      0 ≤ (((μ : ℝ) • restrictedResolventOp α μ u : L2IoiR) : ℝ → ℝ) x
    filter_upwards [Lp.coeFn_smul (μ : ℝ) (restrictedResolventOp α μ u),
      restrictedResolventOp_ae_nonneg hα μ hu] with x hsm hres
    have hsm' :
        (((μ : ℝ) • restrictedResolventOp α μ u : L2IoiR) : ℝ → ℝ) x =
          (μ : ℝ) * (restrictedResolventOp α μ u : ℝ → ℝ) x := hsm
    rw [hsm']
    exact mul_nonneg μ.2.le hres

private theorem ae_finset_range_le {M : ℝ} (N : ℕ) (g : ℕ → L2IoiR)
    (hg : ∀ n, ∀ᵐ x : ℝ ∂(volume : Measure ℝ).restrict (Ioi (0 : ℝ)), (g n : ℝ → ℝ) x ≤ M) :
    ∀ᵐ x : ℝ ∂(volume : Measure ℝ).restrict (Ioi (0 : ℝ)),
      ∀ n ∈ Finset.range N, (g n : ℝ → ℝ) x ≤ M := by
  induction N with
  | zero => exact Filter.Eventually.of_forall fun _ _ hn =>
      absurd (Finset.mem_range.mp hn) (Nat.not_lt_zero _)
  | succ N ih =>
      filter_upwards [ih, hg N] with x hxN hN n hn
      rcases Finset.mem_range.mp hn with hlt
      rcases Nat.lt_succ_iff_lt_or_eq.mp hlt with hlt' | rfl
      · exact hxN n (Finset.mem_range.mpr hlt')
      · exact hN

private theorem ae_finset_sum_eval (N : ℕ) (w : ℕ → ℝ) (g : ℕ → L2IoiR) :
    ∀ᵐ x : ℝ ∂(volume : Measure ℝ).restrict (Ioi (0 : ℝ)),
      ((∑ n ∈ Finset.range N, w n • g n : L2IoiR) : ℝ → ℝ) x =
        ∑ n ∈ Finset.range N, w n * (g n : ℝ → ℝ) x := by
  induction N with
  | zero =>
      simp only [Finset.range_zero, Finset.sum_empty]
      exact Lp.coeFn_zero ℝ 2 ((volume : Measure ℝ).restrict (Ioi (0 : ℝ)))
  | succ N ih =>
      simp_rw [Finset.sum_range_succ]
      filter_upwards [ih,
        Lp.coeFn_add (∑ n ∈ Finset.range N, w n • g n) (w N • g N),
        Lp.coeFn_smul (w N) (g N)] with x h1 hadd hsm
      have hadd' :
          (((∑ n ∈ Finset.range N, w n • g n) + w N • g N : L2IoiR) : ℝ → ℝ) x =
            ((∑ n ∈ Finset.range N, w n • g n : L2IoiR) : ℝ → ℝ) x +
              ((w N • g N : L2IoiR) : ℝ → ℝ) x := hadd
      have hsm' : ((w N • g N : L2IoiR) : ℝ → ℝ) x = w N * (g N : ℝ → ℝ) x := hsm
      rw [hadd', hsm', h1]

/-- **Sub-Markov `L^∞`-Contractivity of the Restricted Semigroup `S₀(t)`**:
if `f ≤ M` a.e. on `(0, ∞)` with `M ≥ 0`, then `restrictedFracLapSemigroup α hα t f ≤ M` a.e.
on `(0, ∞)` for all `t ≥ 0`. -/
theorem restrictedFracLapSemigroup_ae_le {α : ℝ} (hα : FractionalExponent α) (t : ℝ≥0)
    {M : ℝ} (hM : 0 ≤ M) {f : L2IoiR}
    (hf : ∀ᵐ x : ℝ ∂(volume : Measure ℝ).restrict (Ioi (0 : ℝ)), (f : ℝ → ℝ) x ≤ M) :
    ∀ᵐ x : ℝ ∂(volume : Measure ℝ).restrict (Ioi (0 : ℝ)),
      (restrictedFracLapSemigroup α hα t f : ℝ → ℝ) x ≤ M := by
  refine generatedSemigroup_ae_mem_of_scaledResolvent isClosed_Iic ?_ ?_ t hf
  · intro N w hw hwsum g hg
    filter_upwards [ae_finset_range_le N g hg, ae_finset_sum_eval N w g] with x hxfin hxsum
    rw [hxsum]
    calc
      ∑ n ∈ Finset.range N, w n * (g n : ℝ → ℝ) x
          ≤ ∑ n ∈ Finset.range N, w n * M :=
        Finset.sum_le_sum fun n hn => mul_le_mul_of_nonneg_left (hxfin n hn) (hw n)
      _ = (∑ n ∈ Finset.range N, w n) * M := by rw [Finset.sum_mul]
      _ ≤ 1 * M := mul_le_mul_of_nonneg_right hwsum hM
      _ = M := one_mul M
  · intro μ u hu
    exact restrictedResolventOp_ae_le μ hM hu

/-! ### 4. Non-vacuity witness -/

/-- **Non-vacuity witness for `restrictedFracLapResolvent` and `restrictedFracLapSemigroup`**:
for every `α ∈ (0, 2)` and shift `μ > 0`, there exists a nonnegative `L²((0, ∞); ℝ)` datum `f`
such that the restricted resolvent output `R_μ f` is nonzero (so `restrictedFracLapSemigroup` is
not the trivial identity or zero operator). -/
theorem exists_restrictedFracLapSemigroup_nontrivial {α : ℝ} (hα : FractionalExponent α)
    (μ : PositiveShift) :
    ∃ f : L2IoiR,
      (∀ᵐ x : ℝ ∂(volume : Measure ℝ).restrict (Ioi (0 : ℝ)), 0 ≤ (f : ℝ → ℝ) x) ∧
      (restrictedFracLapResolvent α hα).operator μ f ≠ 0 ∧
      0 < ⟪f, (restrictedFracLapResolvent α hα).operator μ f⟫_ℝ := by
  let f : L2IoiR := restrictedL2Map α (gagliardoTentRestricted hα)
  have hf_nn : ∀ᵐ x : ℝ ∂(volume : Measure ℝ).restrict (Ioi (0 : ℝ)), 0 ≤ (f : ℝ → ℝ) x := by
    filter_upwards [coeFn_restIoiR gagliardoTentL2,
      ae_restrict_of_ae (memLp_gagliardoTent.coeFn_toLp)] with x h1 h2
    have h1' : (f : ℝ → ℝ) x = (gagliardoTentL2 : ℝ → ℝ) x := h1
    have h2' : (gagliardoTentL2 : ℝ → ℝ) x = gagliardoTent x := h2
    rw [h1', h2']
    exact gagliardoTent_nonneg x
  have hf_ne : f ≠ 0 := by
    intro h0
    have hnorm0 : ‖f‖ ^ 2 = 0 := by rw [h0]; simp
    have hL2 : ‖gagliardoTentL2‖ ^ 2 = 0 := by
      change ‖restrictedL2Map α (gagliardoTentRestricted hα)‖ ^ 2 = 0 at hnorm0
      rw [← real_inner_self_eq_norm_sq, inner_restrictedL2Map_eq, real_inner_self_eq_norm_sq]
        at hnorm0
      exact hnorm0
    have hg0 : gagliardoTentL2 = 0 := norm_eq_zero.mp ((pow_eq_zero_iff two_ne_zero).mp hL2)
    have h1 : (gagliardoTent : ℝ → ℝ) =ᵐ[volume] 0 := by
      filter_upwards [memLp_gagliardoTent.coeFn_toLp, Lp.coeFn_zero ℝ 2 volume] with x hx hz
      change (gagliardoTentL2 : ℝ → ℝ) x = gagliardoTent x at hx
      rw [← hx, hg0]
      exact hz
    have h4 := congrFun
      ((Continuous.ae_eq_iff_eq (volume : Measure ℝ) continuous_gagliardoTent
        continuous_const).mp h1) 1
    have h5 : gagliardoTent 1 = 1 := by simp [gagliardoTent]
    rw [h5] at h4
    exact one_ne_zero h4
  have hpos : 0 < ⟪f, (restrictedFracLapResolvent α hα).operator μ f⟫_ℝ := by
    change 0 < ⟪f, restrictedL2Map α (restrictedResolventSol α μ f)⟫_ℝ
    rw [← restrictedShiftedForm_resolventSol α μ f (restrictedResolventSol α μ f)]
    have hnot0 : restrictedResolventSol α μ f ≠ 0 := by
      intro hu0
      have hff : ⟪f, f⟫_ℝ = 0 := by
        change ⟪f, restrictedL2Map α (gagliardoTentRestricted hα)⟫_ℝ = 0
        rw [← restrictedShiftedForm_resolventSol α μ f (gagliardoTentRestricted hα), hu0,
          map_zero, zero_apply]
      rw [real_inner_self_eq_norm_sq] at hff
      exact hf_ne (norm_eq_zero.mp ((pow_eq_zero_iff two_ne_zero).mp hff))
    obtain ⟨c, hcpos, hcoer⟩ := restrictedShiftedForm_isCoercive α μ
    have hnorm_pos : 0 < ‖restrictedResolventSol α μ f‖ := norm_pos_iff.mpr hnot0
    have hlower : 0 < c * ‖restrictedResolventSol α μ f‖ * ‖restrictedResolventSol α μ f‖ := by
      positivity
    exact lt_of_lt_of_le hlower (hcoer (restrictedResolventSol α μ f))
  have hR_ne : (restrictedFracLapResolvent α hα).operator μ f ≠ 0 := by
    intro hR0
    rw [hR0, inner_zero_right] at hpos
    exact lt_irrefl _ hpos
  exact ⟨f, hf_nn, hR_ne, hpos⟩

end

